---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const categories = Array.from(new Set(allArticles.map((a) => a.data.category)));

const tagCounts = new Map<string, number>();
for (const article of allArticles) {
  for (const tag of article.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const popularTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([tag]) => tag);
---

<BaseLayout title="MusubiPublisher" wide>
  <nav class="category-bar" aria-label="カテゴリ">
    <a class="category-pill active" href={withBase('')}>すべて</a>
    {categories.map((cat) => (
      <a
        class="category-pill"
        href={withBase(`category/${encodeURIComponent(cat)}/`)}
      >
        {cat}
      </a>
    ))}
  </nav>

  <div class="feed-grid">
    <section class="feed-list" aria-label="最新記事一覧">
      {allArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </section>

    <Sidebar popularTags={popularTags} />
  </div>
</BaseLayout>
