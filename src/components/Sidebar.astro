---
import MusubiLogo from './MusubiLogo.astro';
import { withBase } from '../lib/urls';

interface Props {
  popularTags: string[];
}

const { popularTags } = Astro.props;
---

<aside class="sidebar">
  <section class="sidebar-card app-promo">
    <div class="promo-logo">
      <MusubiLogo size={54} />
    </div>
    <h2 class="promo-title">MusubiReader App</h2>
    <p class="promo-desc">
      毎日のお気に入り記事をひとつに。<br />
      Wi-Fi事前ダウンロード＆広告カットで爆速オフライン閲覧。
    </p>
    <a
      class="promo-cta"
      href="https://yusuke0627.github.io/MusubiReader/"
      rel="noopener noreferrer"
    >
      アプリを見る
    </a>
    <a class="promo-rss" href={withBase('rss.xml')}>
      RSSフィードを購読 ↗
    </a>
  </section>

  {popularTags.length > 0 && (
    <section class="sidebar-card">
      <h2 class="sidebar-heading">人気のトピック</h2>
      <div class="topic-list">
        {popularTags.map((tag) => (
          <span class="topic-chip">#{tag}</span>
        ))}
      </div>
    </section>
  )}
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sidebar-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 22px 20px;
    box-shadow: var(--card-shadow);
  }
  .app-promo {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .promo-logo {
    color: var(--indigo);
    margin-bottom: 2px;
  }
  .promo-title {
    margin: 0;
    font-size: 18px;
    font-weight: 800;
    color: var(--text);
  }
  .promo-desc {
    margin: 0;
    font-size: 13px;
    line-height: 1.65;
    color: var(--muted);
  }
  .promo-cta {
    display: inline-block;
    width: 100%;
    margin-top: 6px;
    padding: 11px 16px;
    border-radius: 12px;
    background: var(--indigo);
    color: var(--indigo-contrast);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .promo-cta:hover {
    text-decoration: none;
    opacity: 0.9;
  }
  .promo-rss {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    margin-top: 2px;
  }
  .sidebar-heading {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 800;
    color: var(--text);
  }
  .topic-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .topic-chip {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    background: var(--surface-soft);
    color: var(--muted);
    border: 1px solid var(--border);
  }
</style>
