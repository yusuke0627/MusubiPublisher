---
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
}

const {
  title,
  description = '海外・国内の話題をAIと編集部で分かりやすく整理してお届けするキュレーションメディア。',
  ogType = 'website',
  publishedAt,
} = Astro.props;

const siteName = 'MusubiPublisher';
const fullTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://yusuke0627.github.io').toString();
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${siteName} RSS`}
      href={withBase('rss.xml')}
    />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {publishedAt && (
      <meta property="article:published_time" content={publishedAt.toISOString()} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {adsenseClient && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}

    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #faf6ee;
        --surface: #ffffff;
        --surface-soft: #f3ede0;
        --text: #141e30;
        --muted: #526075;
        --border: #e4dccb;
        --accent: #d93848;
        --accent-soft: rgba(217, 56, 72, 0.1);
        --indigo: #1e2d4a;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0c1220;
          --surface: #141d31;
          --surface-soft: #1b2740;
          --text: #eef2f8;
          --muted: #98a6bd;
          --border: #273552;
          --accent: #ff5c6c;
          --accent-soft: rgba(255, 92, 108, 0.15);
          --indigo: #93b4f5;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header.site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: var(--surface);
        border-bottom: 1px solid var(--border);
      }
      .header-inner {
        max-width: 820px;
        margin: 0 auto;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .brand {
        font-weight: 800;
        font-size: 19px;
        color: var(--text);
        letter-spacing: -0.02em;
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .brand:hover { text-decoration: none; }
      .brand-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--accent);
        display: inline-block;
      }
      nav.site-nav {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        font-weight: 600;
      }
      nav.site-nav a { color: var(--muted); }
      nav.site-nav a:hover { color: var(--text); text-decoration: none; }
      main.container {
        max-width: 820px;
        margin: 0 auto;
        padding: 28px 20px 64px;
      }
      footer.site-footer {
        border-top: 1px solid var(--border);
        background: var(--surface);
        padding: 28px 20px;
        text-align: center;
        font-size: 13px;
        color: var(--muted);
      }
      .footer-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 16px;
        margin-bottom: 10px;
      }
      .footer-links a { color: var(--muted); }
      .badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        background: var(--accent-soft);
        color: var(--accent);
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase('')}>
          <span class="brand-dot" aria-hidden="true"></span>
          MusubiPublisher
        </a>
        <nav class="site-nav" aria-label="メインナビゲーション">
          <a href={withBase('')}>ホーム</a>
          <a href={withBase('about/')}>このサイトについて</a>
          <a href={withBase('rss.xml')}>RSS</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-links">
        <a href={withBase('about/')}>このサイトについて</a>
        <a href={withBase('privacy/')}>プライバシーポリシー</a>
        <a href={withBase('rss.xml')}>RSSフィード</a>
        <a href="https://yusuke0627.github.io/MusubiReader/" rel="noopener noreferrer">
          MusubiReader アプリ
        </a>
      </div>
      <p style="margin:0;">&copy; {new Date().getFullYear()} MusubiPublisher</p>
    </footer>
  </body>
</html>
